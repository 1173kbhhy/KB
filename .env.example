# ═══════════════════════════════════════════════════════════════
# NOVA AI — 配置示例
# ═══════════════════════════════════════════════════════════════
#
# 使用方法：
#   1. 把本文件复制为 .env（同目录）
#      Windows:  copy .env.example .env
#      Linux/mac: cp .env.example .env
#   2. 按需修改下面的配置
#   3. .env 已被 .gitignore 忽略，**请勿提交到仓库**
#
# ⚠️ 本文件不包含任何真实密钥，API Key 需要你自己申请并填写。
# ═══════════════════════════════════════════════════════════════


# ── 联网检索（可选）─────────────────────────────────────────
#
# 需要联网功能时才配置。申请地址：https://www.firecrawl.dev
# 填了之后，在聊天界面打开「联网」开关，模型即可检索互联网。
# 留空则关闭联网检索 —— **本地对话、知识库、记忆功能不受影响**。
#
# 本项目完全离线可用，联网检索是可选增强。
FIRECRAWL_API_KEY=


# ── 嵌入模型（一般无需改动）─────────────────────────────────
#
# 使用本机 Ollama 做向量嵌入，无需 PyTorch，也无需额外下载 550MB 依赖。
# 首次使用前请先执行一次：
#     ollama pull nomic-embed-text
#
# 注意：输出维度必须与向量库一致（默认 768）。
# 若改用其他嵌入模型，需删除 qdrant_data/ 后重新建库。
EMBED_MODEL=nomic-embed-text


# ── Ollama 服务地址 ────────────────────────────────────────
#
# 必须是本机地址。本应用不接受远程 Ollama，也不建议改成局域网地址
# （HTTP 服务本身仅绑定 127.0.0.1，不对外暴露）。
OLLAMA_BASE_URL=http://localhost:11434


# ── 知识库存储位置（一般无需改动）──────────────────────────
#
# 文档放在 kb_data 目录，启动时自动索引；支持子目录递归。
# 留空使用项目内默认路径（kb_data/ 与 qdrant_data/）。
# RAG_DATA_DIR=./kb_data
# RAG_QDRANT_PATH=./qdrant_data


# ── 检索重排序（进阶，可选）─────────────────────────────────
#
# 两阶段检索：先向量粗召回，再重排精排。
# 可选值：
#   off      纯向量，最快
#   lexical  混合打分（默认，零额外依赖，中文友好）
#   ollama   神经重排，需先 pull 专用模型，质量最好但更慢
#   hybrid   神经 + 词法
#
# 提示：知识库文档较少时（如少于 10 篇），off 往往不输 lexical，
# 因为候选池太小，重排没有优化空间。建议文档变多后再切 ollama。
RERANK_MODE=lexical

# 神经重排所用模型（仅 RERANK_MODE=ollama/hybrid 时生效）
# 需自行拉取：ollama pull dengcao/Qwen3-Reranker-0.6B
# RERANK_MODEL=dengcao/Qwen3-Reranker-0.6B

# 送入重排的候选条数。条数越多越准，但越慢（每条一次模型调用）。
# 显存紧张时可调小到 8。
# RERANK_MERGE_N=20

# 重排模型打分后的驻留时长。设短一点可避免与主模型抢显存。
# RERANK_KEEP_ALIVE=30s
